function getProductsForGarment(
  garmentLabel: string,
  userGender: string,
): ProductItem[] {
  const gender = userGender as "men" | "women" | "all";
  return PRODUCT_CATALOG.filter(
    (p) =>
      p.garmentLabel === garmentLabel &&
      (gender === "all" || p.gender === gender || p.gender === "all"),
  );
}

